{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "useDefineForClassFields": false
  },
  "include": [
    "src"
  ]
}