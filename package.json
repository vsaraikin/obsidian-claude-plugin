{
  "name": "obsidian-claude-plugin",
  "version": "0.1.5",
  "description": "Obsidian sidebar chat for a local Claude Code agent",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc && node esbuild.config.mjs production",
    "typecheck": "tsc",
    "test:view": "esbuild src/view.ts --external:obsidian --bundle --platform=node --format=cjs --target=es2022 --outfile=dist/view-test.cjs --define:import.meta.url=__u --banner:js=\"var __u=require('url').pathToFileURL(__filename).href;\" --log-level=warning && node scripts/view-test.cjs ./dist/view-test.cjs",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --target=es2022 --outfile=dist/smoke.cjs --define:import.meta.url=__u --banner:js=\"var __u=require('url').pathToFileURL(__filename).href;\" --log-level=warning && node dist/smoke.cjs",
    "lint": "eslint src"
  },
  "author": "Vladimir Saraikin",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^21.0.3",
    "obsidian": "^1.14.4",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/vsaraikin/obsidian-claude-plugin.git"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  }
}
